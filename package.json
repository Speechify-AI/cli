{
  "name": "@speechifyai/cli",
  "version": "0.1.0",
  "private": true,
  "description": "SpeechifyAI command-line companion to the developer console — synthesize speech and manage voices from your terminal.",
  "type": "module",
  "bin": {
    "speechifyai": "./dist/bin.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@speechify/api": "^2.0.0",
    "commander": "^15.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "vitest": "^3.2.1"
  }
}
