{
  "name": "@speechifyai/cli",
  "version": "0.1.0",
  "private": true,
  "description": "SpeechifyAI command-line companion to the developer console — synthesize speech and manage voices from your terminal.",
  "type": "module",
  "bin": {
    "speechifyai": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "1.3.0",
    "@speechify/api": "4.0.1",
    "@vercel/detect-agent": "1.2.3",
    "commander": "15.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "24.13.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
